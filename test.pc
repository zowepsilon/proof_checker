Prop TopIntro():
  => Top

Prop BotElim(infer p):
  Bot => p

Prop AndIntro(infer p, infer q):
  p, q => p.q

Prop AndElimLeft(infer p, q):
  p.q => p

Prop AndElimRight(p, infer q):
  p.q => q

Prop ExclMid(infer p):
  => p | ~p

Prop AndComm(infer p, infer q):
  q.p => p.q
Proof:
  AndIntro:
    AndElimRight(q):
      Ax
    AndElimLeft(p):
      Ax

Prop AndComm2(infer p, infer q):
  p.q => q.p
Proof:
  AndComm:
    Ax
