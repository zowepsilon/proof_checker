Prop AndIntro(infer p, infer q):
  p, q => p.q
Proof:
  Admitted

Prop ExclMid(infer p):
  => p | ~p
Proof:
  Admitted


Prop AndComm(infer p, infer q):
  q.p => p.q
Proof:
  AndIntro:
    AndElimRight(q):
      Ax
    AndElimLeft(p):
      Ax

Prop AndComm2(infer p, infer q):
  p.q => q.p
Proof:
  AndComm:
    Ax
